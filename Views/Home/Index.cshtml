@{
    ViewData["Title"] = "AI Transformation";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/atropos@2.0.2/atropos.min.css">
<script src="https://cdn.jsdelivr.net/npm/atropos@2.0.2/atropos.min.js"></script>
<script src="https://unpkg.com/scrollreveal"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --lime: #ccff00;
        --dark: #0f1113;
        --glass: rgba(255, 255, 255, 0.85);
        --trans-smooth: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-bs-theme="dark"] { --glass: rgba(26, 29, 32, 0.9); }

    body { overflow-x: hidden; background: #f3f6f3; transition: var(--trans-smooth); }
    [data-bs-theme="dark"] body { background: #0c0e10; }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(2deg); }
    }

    .hero-container {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
    }

    .floating-badge {
        position: absolute;
        background: var(--glass);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 14px 24px;
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 15px 35px rgba(0,0,0,0.08);
        font-weight: 800;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        z-index: 10;
        animation: float 5s ease-in-out infinite;
        backface-visibility: hidden;
    }

    .atropos-hero { width: 100%; max-width: 1000px; }

    /* New Aesthetic Card Style from your Request */
    .large-hero-card {
        background: white;
        border-radius: 55px;
        padding: 6rem 3rem;
        text-align: center;
        border: 1px solid rgba(0,0,0,0.04);
        box-shadow: 0 50px 100px rgba(0,0,0,0.08);
        transition: var(--trans-smooth);
    }

    [data-bs-theme="dark"] .large-hero-card {
        background: #121416;
        border-color: rgba(255,255,255,0.05);
    }

    .display-main {
        font-size: clamp(2.5rem, 8vw, 5.5rem);
        font-weight: 950;
        color: var(--dark);
        line-height: 0.95;
        letter-spacing: -3px;
    }

    [data-bs-theme="dark"] .display-main { color: white; }

    .preview-section {
        background: #111;
        border-radius: 60px;
        padding: 100px 50px;
        margin: 60px 15px;
        color: white;
        box-shadow: 0 40px 80px rgba(0,0,0,0.2);
    }

    .step-box-large {
        background: white;
        border-radius: 40px;
        padding: 45px;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.02);
        transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    [data-bs-theme="dark"] .step-box-large:not(.bg-dark) { background: #1a1d20; }

    .step-box-large:hover {
        transform: translateY(-15px) scale(1.02);
        box-shadow: 0 30px 60px rgba(0,0,0,0.1);
    }

    /* Updated Button Style */
    .btn-hero {
        background: #000;
        color: var(--lime);
        border: 1.5px solid var(--lime);
        font-weight: 900;
        padding: 20px 50px;
        border-radius: 50px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        transition: 0.3s;
    }

    .btn-hero:hover {
        background: var(--lime);
        color: #000;
        box-shadow: 0 20px 40px rgba(204, 255, 0, 0.3);
    }

    @@media (max-width: 768px) {
        .large-hero-card { padding: 4rem 1.5rem; border-radius: 35px; }
        .preview-section { border-radius: 40px; padding: 60px 25px; }
        .floating-badge { display: none !important; }
    }
</style>

<div class="container-fluid dashboard-container">
    @* --- Master Hero Block (New Neural V2.0 Design) --- *@
    <div class="hero-container">
        <div class="floating-badge d-none d-md-block" style="top: 10%; left: 8%;">
            <i class="bi bi-fire text-danger me-2"></i> 2500+ Cal Protocols
        </div>
        <div class="floating-badge d-none d-md-block" style="bottom: 15%; right: 8%; animation-delay: 1.5s;">
            <i class="bi bi-patch-check-fill text-success me-2"></i> Indian Macro Hub
        </div>

        <div class="atropos atropos-hero">
            <div class="atropos-scale">
                <div class="atropos-rotate">
                    <div class="atropos-inner">
                        <div class="large-hero-card">
                            <div class="mb-5" data-atropos-offset="5">
                                <span class="badge rounded-pill bg-dark text-white px-4 py-2 fw-black" style="letter-spacing: 2.5px; font-size: 0.7rem;">
                                    <i class="bi bi-cpu-fill me-2" style="color:var(--lime)"></i> NEURAL ENGINE V2.0
                                </span>
                            </div>

                            <h1 class="display-main" data-atropos-offset="12">
                                AI Plans. <br> <span style="color:var(--lime)">Real Results.</span>
                            </h1>

                            <p class="text-muted mt-4 fs-5 px-lg-5 fw-bold opacity-75" data-atropos-offset="3">
                                Precision-engineered 7-day Indian nutrition using <span class="text-dark fw-black">Gemini AI</span> for your specific bio-signature.
                            </p>

                            <div class="mt-5" data-atropos-offset="10">
                                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-hero shadow-lg">
                                    Initialize Protocol <i class="bi bi-arrow-right-short ms-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- Future Trajectory Block (Chart Section) --- *@
    <div class="container preview-section animate__animated animate__fadeIn">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 reveal-left">
                <h2 class="display-5 fw-black mb-4 uppercase">Simulate Your <span style="color:var(--lime)">Future</span></h2>
                <p class="opacity-75 fs-5 lh-base">Our AI predicts your weight trajectory with 98% accuracy based on thermal-dynamic data. Science meeting nutrition.</p>
                <div class="mt-5 space-y-3">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-2 bg-lime text-dark rounded-3 me-3" style="background:var(--lime)"><i class="bi bi-check-lg"></i></div>
                        <span class="fw-bold text-uppercase small letter-spacing-1">Protein Synthesis Optimization</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="p-2 bg-lime text-dark rounded-3 me-3" style="background:var(--lime)"><i class="bi bi-check-lg"></i></div>
                        <span class="fw-bold text-uppercase small letter-spacing-1">Localized Indian Budget Macros</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 reveal-right">
                <div class="bg-white p-4 rounded-4 shadow-2xl" style="border: 8px solid rgba(255,255,255,0.05);">
                    <canvas id="previewChart" style="height: 320px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    @* --- Operational Matrix (Step Cards) --- *@
    <div class="container pb-5 mb-5" id="how">
        <div class="row g-4">
            <div class="col-lg-4 reveal-step">
                <div class="step-box-large">
                    <div class="h1 fw-black opacity-10 mb-0" style="font-size: 4rem;">01</div>
                    <h4 class="fw-black text-uppercase mt-n3">Bio-Identity</h4>
                    <p class="text-muted fw-bold">Input your vitals and lifestyle parameters into our neural core.</p>
                </div>
            </div>
            <div class="col-lg-4 reveal-step">
                <div class="step-box-large bg-dark text-white border-0">
                    <div class="h1 fw-black opacity-25 mb-0" style="color:var(--lime); font-size: 4rem;">02</div>
                    <h4 class="fw-black text-uppercase mt-n3" style="color:var(--lime)">Neural Sync</h4>
                    <p class="opacity-75 fw-bold">Gemini AI generates a 100% accurate, cost-effective nutrition roadmap.</p>
                </div>
            </div>
            <div class="col-lg-4 reveal-step">
                <div class="step-box-large">
                    <div class="h1 fw-black opacity-10 mb-0" style="font-size: 4rem;">03</div>
                    <h4 class="fw-black text-uppercase mt-n3">Bio-Evolution</h4>
                    <p class="text-muted fw-bold">Monitor your transformation live on your encrypted bio-dashboard.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Initialize 3D Core with Mobile Safety
        if(window.innerWidth > 768) {
            Atropos({
                el: '.atropos-hero',
                activeOffset: 60,
                shadow: true,
                shadowOffset: 60,
                shadowScale: 0.95
            });
        }

        // 2. Scroll Animations
        ScrollReveal().reveal('.reveal-left', { origin: 'left', distance: '80px', duration: 1200, delay: 200 });
        ScrollReveal().reveal('.reveal-right', { origin: 'right', distance: '80px', duration: 1200, delay: 400 });
        ScrollReveal().reveal('.reveal-step', { interval: 200, origin: 'bottom', distance: '40px', duration: 1000 });

        // 3. Trajectory Chart
        const ctx = document.getElementById('previewChart').getContext('2d');
        const grad = ctx.createLinearGradient(0, 0, 0, 300);
        grad.addColorStop(0, 'rgba(204, 255, 0, 0.4)');
        grad.addColorStop(1, 'rgba(204, 255, 0, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5'],
                datasets: [{
                    data: [85, 83.2, 81.5, 80.1, 78.5],
                    borderColor: '#ccff00',
                    borderWidth: 5,
                    tension: 0.45,
                    fill: true,
                    backgroundColor: grad,
                    pointRadius: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { display: false },
                    x: { grid: { display: false }, ticks: { color: '#888', font: { size: 10, weight: 'bold'} } }
                }
            }
        });
    </script>
}