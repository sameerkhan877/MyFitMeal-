@model MyFitMeal.Models.WeeklyPlan

<style>
    :root {
        --lime: #ccff00;
        --dark-bg: #0f1113;
        --glass-panel: rgba(255, 255, 255, 0.04);
    }

    /* Hardware Acceleration for fast scrolling */
    .protocol-container {
        backface-visibility: hidden;
        transform: translateZ(0);
    }

    /* Performance Optimized Card */
    .admin-meal-card {
        background: var(--glass-panel);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        padding: 22px;
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease;
        position: relative;
        z-index: 1; /* Base layer */
    }

        .admin-meal-card:hover {
            transform: translateY(-8px);
            border-color: var(--lime);
            background: rgba(204, 255, 0, 0.01);
        }

    /* Elite Button Stacking Fix */
    .btn-override-action {
        background: var(--lime) !important;
        color: #000 !important;
        font-weight: 900;
        border-radius: 14px;
        padding: 8px 16px;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.5px;
        transition: 0.3s ease;
        position: relative !important;
        z-index: 100 !important; /* Forces top layer interaction */
        pointer-events: auto !important;
        display: inline-flex;
        align-items: center;
        text-decoration: none !important;
        border: none;
    }

        .btn-override-action:hover {
            box-shadow: 0 8px 20px rgba(204, 255, 0, 0.4);
            transform: scale(1.03);
        }

    .glass-header-admin {
        background: #000;
        padding: 25px;
        border-radius: 30px;
        margin-bottom: 35px;
        border: 1px solid rgba(204, 255, 0, 0.15);
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    }

    .meal-entry {
        background: rgba(0, 0, 0, 0.3);
        padding: 10px 14px;
        border-radius: 12px;
        margin-bottom: 10px;
        border-left: 3px solid var(--lime);
        transition: background 0.2s;
    }

        .meal-entry:hover {
            background: rgba(204, 255, 0, 0.03);
        }

    /* Mobile Responsive Logic */
    @@media (max-width: 768px) {
        .glass-header-admin

    {
        flex-direction: column;
        text-align: center;
        gap: 20px;
    }

    .display-6 {
        font-size: 1.8rem;
    }

    .admin-meal-card {
        padding: 18px;
    }

    }
</style>

<div class="container-fluid py-4 protocol-container">
    @* --- Master Protocol Header --- *@
    <div class="glass-header-admin d-flex justify-content-between align-items-center animate__animated animate__fadeIn">
        <div>
            <h2 class="fw-black mb-0 text-white text-uppercase display-6 lh-1">User <span style="color:var(--lime)">Protocol</span></h2>
            <div class="d-flex align-items-center mt-2 justify-content-center justify-content-md-start">
                <span class="badge bg-dark border border-lime border-opacity-25 text-lime me-2 px-3 py-2" style="font-size: 0.6rem; color:var(--lime)">NODE: ACTIVE</span>
                <p class="text-muted small mb-0 fw-bold text-uppercase letter-spacing-1">Sync: @ViewBag.UserEmail</p>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index"
           class="btn btn-outline-light rounded-pill px-4 fw-bold shadow-sm transition-03">
            <i class="bi bi-arrow-left-circle me-2"></i> Master Database
        </a>
    </div>

    @* --- Daily Plan Matrix --- *@
    <div class="row g-4">
        @foreach (var day in Model.Days.OrderBy(d => d.DayNumber))
        {
            <div class="col-md-6 col-xl-4 animate__animated animate__fadeInUp">
                <div class="admin-meal-card shadow-lg h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="badge bg-dark text-lime rounded-pill px-3 py-2 border border-secondary border-opacity-25 fw-black" style="color:var(--lime); font-size: 0.7rem;">
                            CYCLE @day.DayNumber
                        </span>

                        @* Tag Helper Refinement *@
                        <a asp-area="Admin"
                           asp-controller="AdminDashboard"
                           asp-action="EditMeal"
                           asp-route-id="@day.Id"
                           class="btn btn-override-action shadow-sm">
                            <i class="bi bi-cpu-fill me-1"></i> Override
                        </a>
                    </div>

                    <div class="protocol-data flex-grow-1">
                        <div class="meal-entry">
                            <small class="text-muted text-uppercase fw-black d-block mb-1" style="font-size: 0.6rem; letter-spacing: 1px;">Morning Fuel</small>
                            <p class="mb-0 text-white small fw-bold opacity-90">@day.Breakfast</p>
                        </div>
                        <div class="meal-entry">
                            <small class="text-muted text-uppercase fw-black d-block mb-1" style="font-size: 0.6rem; letter-spacing: 1px;">Midday Fuel</small>
                            <p class="mb-0 text-white small fw-bold opacity-90">@day.Lunch</p>
                        </div>
                        <div class="meal-entry">
                            <small class="text-muted text-uppercase fw-black d-block mb-1" style="font-size: 0.6rem; letter-spacing: 1px;">Activity Snack</small>
                            <p class="mb-0 text-white small fw-bold opacity-90">@day.Snack</p>
                        </div>
                        <div class="meal-entry mb-0">
                            <small class="text-muted text-uppercase fw-black d-block mb-1" style="font-size: 0.6rem; letter-spacing: 1px;">Night Recovery</small>
                            <p class="mb-0 text-white small fw-bold opacity-90">@day.Dinner</p>
                        </div>
                    </div>

                    @* Personalized Admin Advisory *@
                    @if (!string.IsNullOrEmpty(day.AdminNote))
                    {
                        <div class="mt-4 p-3 rounded-4 border border-dashed border-lime border-opacity-25 bg-black bg-opacity-50">
                            <div class="d-flex align-items-center mb-1">
                                <i class="bi bi-robot text-lime me-2" style="font-size: 0.8rem;"></i>
                                <small class="text-lime fw-black text-uppercase" style="font-size: 0.55rem; letter-spacing: 1px;">Live Advisory</small>
                            </div>
                            <p class="x-small text-muted mb-0 font-italic">"@day.AdminNote"</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>