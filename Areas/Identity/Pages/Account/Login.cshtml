@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null; // Hum custom layout handle karenge for full-screen effect
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - MyFitMeal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        :root {
            --lime: #ccff00;
            --dark-bg: #0f1113;
        }

        body {
            background: radial-gradient(circle at top right, #1a1d20, var(--dark-bg));
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }

        .login-glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 40px;
            padding: 45px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
        }

        .brand-icon {
            color: var(--lime);
            font-size: 3.5rem;
            filter: drop-shadow(0 0 15px rgba(204, 255, 0, 0.4));
        }

        .glass-input {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            border-radius: 15px !important;
            color: white !important;
            padding: 15px !important;
            transition: 0.3s ease;
        }

            .glass-input:focus {
                background: rgba(255, 255, 255, 0.1) !important;
                border-color: var(--lime) !important;
                box-shadow: 0 0 20px rgba(204, 255, 0, 0.2) !important;
                outline: none;
            }

        .btn-login {
            background: var(--lime);
            color: #000;
            font-weight: 800;
            border-radius: 15px;
            padding: 15px;
            border: none;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.3s;
        }

            .btn-login:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(204, 255, 0, 0.4);
                background: #b8e600;
            }

        .text-lime {
            color: var(--lime);
        }

        .form-check-input:checked {
            background-color: var(--lime);
            border-color: var(--lime);
        }

        /* Validation Summary Styling */
        .validation-summary-errors ul {
            list-style: none;
            padding: 0;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

    <div class="login-glass-card animate__animated animate__zoomIn">
        <div class="text-center mb-4">
            <div class="brand-icon mb-2">
                <i class="bi bi-nut-fill"></i>
            </div>
            <h2 class="fw-bold">MyFit<span class="text-lime">Meal</span></h2>
            <p class="text-muted small">Precision AI Nutrition Gateway</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Input.Email" class="small fw-bold mb-2 opacity-50 text-uppercase">Email Identity</label>
                <input asp-for="Input.Email" class="form-control glass-input" autocomplete="username" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger x-small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="small fw-bold mb-2 opacity-50 text-uppercase">Secure Password</label>
                <input asp-for="Input.Password" class="form-control glass-input" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger x-small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label small text-muted" asp-for="Input.RememberMe">Remember Me</label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none text-lime">Forgot?</a>
            </div>

            <button id="login-submit" type="submit" class="w-100 btn btn-login mb-4">Authorize Access</button>

            <div class="text-center">
                <p class="small text-muted mb-0">
                    New transformation?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-lime fw-bold text-decoration-none">Create Account</a>
                </p>
                <p class="mt-2">
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="x-small text-muted text-decoration-none">Resend confirmation email</a>
                </p>
            </div>
        </form>
    </div>

    @* Client-side validation scripts *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>