@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = null; // Full-screen immersive experience
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Join MyFitMeal - Premium AI Transformation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <style>
        :root {
            --lime: #ccff00;
            --dark-bg: #0f1113;
        }

        body {
            background: radial-gradient(circle at bottom left, #1a1d20, var(--dark-bg));
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-family: 'Segoe UI', sans-serif;
            overflow: hidden;
        }

        .register-glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 40px;
            padding: 40px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.4);
        }

        .glass-input {
            background: rgba(255, 255, 255, 0.05) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            border-radius: 12px !important;
            color: white !important;
            padding: 12px 15px !important;
            transition: 0.3s ease;
        }

            .glass-input:focus {
                background: rgba(255, 255, 255, 0.1) !important;
                border-color: var(--lime) !important;
                box-shadow: 0 0 15px rgba(204, 255, 0, 0.2) !important;
                outline: none;
            }

        .btn-register {
            background: var(--lime);
            color: #000;
            font-weight: 800;
            border-radius: 15px;
            padding: 15px;
            border: none;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.3s;
        }

            .btn-register:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(204, 255, 0, 0.3);
                background: #b8e600;
            }

        .text-lime {
            color: var(--lime);
        }

        .input-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #888;
            margin-bottom: 8px;
            display: block;
        }
    </style>
</head>
<body>

    <div class="register-glass-card animate__animated animate__zoomIn">
        <div class="text-center mb-4">
            <h2 class="fw-bold mb-1">Join the <span class="text-lime">Evolution</span></h2>
            <p class="text-muted small">Initialize your AI-driven fitness profile</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="input-label">Identity Email</label>
                <input asp-for="Input.Email" class="form-control glass-input" autocomplete="username" placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger x-small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.Password" class="input-label">Passcode</label>
                    <input asp-for="Input.Password" class="form-control glass-input" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger x-small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Input.ConfirmPassword" class="input-label">Verify</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control glass-input" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger x-small"></span>
                </div>
            </div>

            <div class="mb-4">
                <p class="x-small text-muted mt-2">
                    <i class="bi bi-shield-check-fill text-lime"></i> By registering, you agree to our AI-powered transformation terms.
                </p>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-register mb-3">Create Master Profile</button>

            <div class="text-center">
                <p class="small text-muted">
                    Already a member?
                    <a asp-page="./Login" class="text-lime fw-bold text-decoration-none">Access Dashboard</a>
                </p>
            </div>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>